# Authoritative grants. Copy to grants.auto.tfvars (gitignored).
# Key = "<securable_type>/<full_name>" (parsed to pick the securable).
#   import_id (when importing) = the same string as the key.
# List EVERY live privilege on the securable (system defaults + implicit creator grants);
# databricks_grants is authoritative and revokes anything not listed.

grants = {
  "metastore/<metastore_id>" = {
    grants    = [{ principal = "account users", privileges = ["USE_MARKETPLACE_ASSETS"] }]
    import_id = "metastore/<metastore_id>"
  }
  "catalog/my_catalog" = {
    grants    = [{ principal = "my_group", privileges = ["USE_CATALOG", "USE_SCHEMA", "SELECT"] }]
    import_id = "catalog/my_catalog"
  }
}
