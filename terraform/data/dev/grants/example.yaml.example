# Authoritative grants. Copy to a real *.yaml file here. Key = "<securable_type>/<full_name>".
#   import_id = the same string as the key.
#
# databricks_grants is authoritative: list EVERY live privilege on the securable, or the
# plan will show a change (and apply would revoke). Each grant sets EITHER:
#   - presets:    one or more privilege-preset names (see ../../../privilege_presets.tf),
#                 resolved to privileges for this securable type. PREFERRED going forward.
#                 DATA_READER / DATA_EDITOR mirror the Catalog Explorer "Privilege presets".
#   - privileges: raw UC privileges. The escape hatch for existing grants that don't fit
#                 a preset. Use when importing, then migrate to `presets` where possible.
# Exactly one of presets / privileges per grant — not both.

# Preset-based (preferred) — mirrors the UI Data Reader / Data Editor presets:
catalog/my_catalog:
  grants:
    - principal: data_engineers
      presets: [DATA_EDITOR]
    - principal: analysts
      presets: [DATA_READER]
  import_id: catalog/my_catalog

# Raw privileges (escape hatch) — e.g. a metastore grant that fits no preset:
metastore/00000000-0000-0000-0000-000000000000:
  grants:
    - principal: account users
      privileges: [USE_MARKETPLACE_ASSETS]
  import_id: metastore/00000000-0000-0000-0000-000000000000
