# Connections. Copy to connections.auto.tfvars (gitignored). Key = connection name.
#   import_id (when importing) = "<metastore_id>|<name>"  (get the metastore_id from
#   `databricks metastores summary`). Secrets (e.g. bearer_token) are NOT stored here.

connections = {
  "my_conn" = {
    connection_type = "HTTP"
    owner           = "owner@example.com"
    options         = { auth_scheme = "bearer", host = "https://api.example.com", port = "443", base_path = "/" }
    import_id       = "00000000-0000-0000-0000-000000000000|my_conn"
  }
}
