# Volumes. Copy to volumes.auto.tfvars (gitignored). Key = "catalog.schema.volume".
#   import_id (when importing) = "catalog.schema.volume".

volumes = {
  "my_catalog.my_schema.my_volume" = {
    owner     = "owner@example.com"
    comment   = "example volume"
    import_id = "my_catalog.my_schema.my_volume"
  }
}
