# External locations. Copy to external_locations.auto.tfvars (gitignored). Key = name.
#   import_id (when importing) = name.

external_locations = {
  "my_el" = {
    owner           = "owner@example.com"
    url             = "s3://my-bucket/path"
    credential_name = "my_sc"
    import_id       = "my_el"
  }
}
