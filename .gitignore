# ---- Terraform ----
# Local state and backups (never commit state)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl.bak
crash.log
crash.*.log

# Variable files that may contain customer-specific or sensitive values.
# Commit only *.tfvars.example templates.
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files (may embed sensitive values / resource IDs)
*.tfplan
*.plan

# ---- Credentials / secrets ----
.databrickscfg
*.pem
*.key
*secret*
*credential*.json
.env
.env.*

# ---- Discovery output (may contain real identifiers) ----
discovery-output/
exporter-output/
generated/
*.exported.tf

# ---- OS / editor ----
.DS_Store
*.swp
.idea/
.vscode/
